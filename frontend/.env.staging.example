# ─────────────────────────────────────────────────
# StellarSplit Frontend — Staging Environment
# Copy to .env on your Vercel staging deployment
# ─────────────────────────────────────────────────

# ── Stellar / Soroban (always testnet for staging) ──
VITE_CONTRACT_ID=CHANGE_ME_STAGING_CONTRACT_ADDRESS
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# ── SPLT Reward Token ──
# VITE_SPLT_CONTRACT_ID=CHANGE_ME_STAGING_SPLT_ADDRESS

# ── Backend API ──
VITE_API_URL=https://stellarsplit-api-staging.up.railway.app

# ── USDC (testnet) ──
# VITE_USDC_CONTRACT_ID=CHANGE_ME_TESTNET_USDC_ADDRESS

# ── Receipt Storage (IPFS / R2) ──
# VITE_PINATA_JWT=

# ── AI Receipt Scanning ──
# VITE_WIRO_API_KEY=
# VITE_OPENAI_API_KEY=

# ── Analytics ──
VITE_ANALYTICS_ENDPOINT=https://stellarsplit-api-staging.up.railway.app/api/v1/events

# ── Feature Flags ──
# Values: "true" | "false" — override per-deploy without code changes
VITE_FF_FEEDBACK_WIDGET=true
VITE_FF_REFERRAL_UI=true
VITE_FF_SAVINGS_POOL=true
VITE_FF_GUARDIAN=true
VITE_FF_MERCHANT_QR=true

# ── DeFi APY ──
# VITE_DEFI_APY_URL=
VITE_DEFI_APY=8.5
